# Evergreen Linux kernel defconfig
#
# Applied as `.config` before `make olddefconfig`. Options not listed here keep
# the upstream defaults for the target architecture.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86_GENERIC=y
CONFIG_MX86_64=y
CONFIG_SMP=y
CONFIG_PREEMPT=y

# usr-merged root, btrfs root filesystem, and cgroups v2 for pine.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y

CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# Device management, networking, and the XFCE stack.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DRM=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_WIRELESS=y
CONFIG_BT=y

# Rust support (requires rustc, rust-src and bindgen in the build environment).
CONFIG_RUST=y

# Secure Boot / signed modules infrastructure.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
